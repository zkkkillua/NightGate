{
  "manifest_version": 3,
  "name": "收尾",
  "version": "0.1.5",
  "description": "让当前视频安心收尾，门禁后不再开启下一段娱乐。",
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "webNavigation",
    "declarativeNetRequest",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://bilibili.com/*",
    "https://bilibili.com/*",
    "http://*.bilibili.com/*",
    "https://*.bilibili.com/*",
    "http://iqiyi.com/*",
    "https://iqiyi.com/*",
    "http://*.iqiyi.com/*",
    "https://*.iqiyi.com/*",
    "http://netflix.com/*",
    "https://netflix.com/*",
    "http://*.netflix.com/*",
    "https://*.netflix.com/*",
    "http://v.qq.com/*",
    "https://v.qq.com/*",
    "http://*.v.qq.com/*",
    "https://*.v.qq.com/*",
    "http://youtube.com/*",
    "https://youtube.com/*",
    "http://*.youtube.com/*",
    "https://*.youtube.com/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "收尾 · 网页保护"
  },
  "incognito": "spanning",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "finished.html", "styles.css"],
      "matches": [
        "http://bilibili.com/*", "https://bilibili.com/*", "http://*.bilibili.com/*", "https://*.bilibili.com/*",
        "http://iqiyi.com/*", "https://iqiyi.com/*", "http://*.iqiyi.com/*", "https://*.iqiyi.com/*",
        "http://netflix.com/*", "https://netflix.com/*", "http://*.netflix.com/*", "https://*.netflix.com/*",
        "http://v.qq.com/*", "https://v.qq.com/*", "http://*.v.qq.com/*", "https://*.v.qq.com/*",
        "http://youtube.com/*", "https://youtube.com/*", "http://*.youtube.com/*", "https://*.youtube.com/*"
      ]
    }
  ]
}
