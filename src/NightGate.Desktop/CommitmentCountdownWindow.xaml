<Window x:Class="NightGate.Desktop.CommitmentCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NightGate.Desktop"
        Title="收尾倒计时"
        Width="476"
        Height="244"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="收尾倒计时悬浮卡片"
        AutomationProperties.LiveSetting="Off">
    <Grid x:Name="EffectHost" ClipToBounds="True">
        <local:CountdownRadianceLayer x:Name="RadianceLayer"
                                      IsHitTestVisible="False"
                                      Focusable="False" />
        <Border x:Name="RootCard"
            Margin="48"
            Padding="18,12"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       TextWrapping="Wrap" />
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="CurrentTimeText"
                               FontSize="14"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               AutomationProperties.Name="当前时间"
                               AutomationProperties.LiveSetting="Off" />
                    <TextBlock x:Name="DeadlineText"
                               Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="CountdownLabelText"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="剩余时间" />
                    <TextBlock x:Name="RemainingText"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               FontSize="31"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               AutomationProperties.Name="剩余时间"
                               AutomationProperties.LiveSetting="Off" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="DetailText"
                       Grid.Row="2"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
        </Grid>
        </Border>
    </Grid>
</Window>
