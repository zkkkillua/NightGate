<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\NightGate.ico</ApplicationIcon>
    <AssemblyTitle>收尾 NightGate</AssemblyTitle>
    <Product>收尾 NightGate</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NightGate.Core\NightGate.Core.csproj" />
    <ProjectReference Include="..\NightGate.Protocol\NightGate.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\NightGate.ico"
              Link="Assets\NightGate.ico" />
    <Content Include="..\..\assets\NightGate.ico"
             Link="NightGate.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
