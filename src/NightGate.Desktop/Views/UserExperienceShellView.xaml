<UserControl x:Class="NightGate.Desktop.Views.UserExperienceShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NightGate.Desktop.Views"
             AutomationProperties.Name="设置与向导内容"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="正在连接收尾服务"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <ProgressBar Margin="0,18,0,0"
                             Width="280"
                             Height="6"
                             IsIndeterminate="True"
                             AutomationProperties.Name="正在读取本机设置" />
                <TextBlock Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Text="{Binding Connection.Body}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <Border Grid.Row="0"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource WarningCardBrush}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding Connection.Title}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,9,0,0"
                           Text="{Binding Connection.Body}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Margin="0,9,0,0"
                           Text="保护服务不可用时会安全放行，不会断网、修改电源计划或锁死账户。"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <Button Margin="0,18,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="_重新连接"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="重新连接收尾服务"
                        TabIndex="0" />
            </StackPanel>
        </Border>

        <views:OnboardingWizardView Grid.Row="0">
            <views:OnboardingWizardView.Style>
                <Style TargetType="{x:Type views:OnboardingWizardView}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsAvailable}" Value="True" />
                                <Condition Binding="{Binding IsOnboardingComplete}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </views:OnboardingWizardView.Style>
        </views:OnboardingWizardView>

        <views:SettingsView Grid.Row="0">
            <views:SettingsView.Style>
                <Style TargetType="{x:Type views:SettingsView}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsAvailable}" Value="True" />
                                <Condition Binding="{Binding IsOnboardingComplete}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </views:SettingsView.Style>
        </views:SettingsView>

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="8"
                Background="{StaticResource CardBackgroundBrush}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="操作状态"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</UserControl>
