<UserControl x:Class="NightGate.Desktop.Views.OnboardingWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NightGate.Desktop"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:views="clr-namespace:NightGate.Desktop.Views"
             AutomationProperties.Name="首次设置五步向导"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style TargetType="CheckBox"
               BasedOn="{StaticResource ChecklistItemStyle}" />
        <Style x:Key="WizardPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="完成首次设置"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0"
                           Text="五步完成后，之后这里会变成日常设置。"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource TextButtonStyle}"
                    Content="_刷新状态"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="刷新本机设置"
                    TabIndex="0" />
        </DockPanel>

        <ItemsControl Grid.Row="1"
                      Margin="0,0,0,14"
                      ItemsSource="{Binding OnboardingSteps}"
                      AutomationProperties.Name="向导步骤">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <primitives:UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="3,0"
                            MinHeight="58"
                            Padding="8,6"
                            IsEnabled="{Binding CanNavigate}"
                            Tag="{Binding Number}"
                            Click="Step_Click"
                            AutomationProperties.Name="{Binding Title}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static local:DesktopOnboardingStepState.Current}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static local:DesktopOnboardingStepState.Completed}">
                                        <Setter Property="Opacity" Value="0.82" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       Text="{Binding Number, StringFormat=第 {0}/5 步}"
                                       FontSize="12" />
                            <TextBlock Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Title}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer Grid.Row="2"
                      Style="{StaticResource PageScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="2,0,10,0">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource WizardPanelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedOnboardingStep}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding OnboardingTitle}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,16"
                               Text="{Binding OnboardingBody}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <views:ScheduleLadderView />
                    <Border Margin="0,14,0,0"
                            Style="{StaticResource CardStyle}"
                            Background="{StaticResource WarningCardBrush}">
                        <StackPanel>
                            <TextBlock Text="旧自动关机任务"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="每项都由你单独勾选；只停用，不删除，也不会改动内容已变化的任务。"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,6"
                                       Text="{Binding LegacyMigrationStatusText}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="旧自动关机任务检查状态"
                                       AutomationProperties.LiveSetting="Polite" />
                            <ItemsControl ItemsSource="{Binding LegacyShutdownTasks}"
                                          AutomationProperties.Name="发现的旧自动关机任务">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox MinHeight="40"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding TaskPath}"
                                                  AutomationProperties.Name="{Binding TaskPath}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="停用选中的旧任务（不删除）"
                                        Command="{Binding DisableSelectedLegacyTasksCommand}"
                                        IsEnabled="{Binding CanDisableSelectedLegacyTasks}"
                                        AutomationProperties.Name="逐项确认并停用选中的旧自动关机任务" />
                                <Button Margin="8,0,0,0"
                                        Style="{StaticResource TextButtonStyle}"
                                        Content="恢复此前停用的旧任务"
                                        Command="{Binding RestoreLegacyTasksCommand}"
                                        IsEnabled="{Binding CanRestoreLegacyTasks}"
                                        AutomationProperties.Name="恢复由收尾停用的旧自动关机任务" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource WizardPanelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedOnboardingStep}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding OnboardingTitle}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,16"
                               Text="{Binding OnboardingBody}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <Border Style="{StaticResource CardStyle}">
                        <views:RulesEditorView />
                    </Border>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource WizardPanelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedOnboardingStep}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding OnboardingTitle}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,16"
                               Text="{Binding OnboardingBody}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource InfoCardBrush}">
                        <StackPanel>
                            <TextBlock Text="Chrome 网页保护"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding ChromeProtectionText}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Chrome 网页保护状态"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="扩展缺失、被停用或隐身模式未受保护时会明确降级；最终 Windows 锁屏仍会执行。"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="安装或重新启用扩展："
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="1. 在 Chrome 地址栏打开 chrome://extensions。"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="2. 打开右上角“开发者模式”，选择“加载已解压的扩展程序”。"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="3. 选择 C:\Program Files\NightGate\chrome-extension。"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="4. 点击下方按钮，在扩展选项中选择与“程序与网站”页面相同的网站，点击“保存并授权”，并在 Chrome 提示中允许访问。"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="打开扩展网站权限设置"
                                    Command="{Binding OpenChromeExtensionOptionsCommand}"
                                    AutomationProperties.Name="打开 Chrome 扩展网站权限设置" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="{Binding ChromeExtensionOptionsStatusText}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       AutomationProperties.Name="Chrome 扩展网站权限设置状态"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="若按钮没有打开页面：在 chrome://extensions 找到“收尾”，依次打开“详细信息”→“扩展程序选项”。"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="5. 如需保护隐身窗口，在扩展卡片中打开“详细信息”，再开启“在无痕模式下启用”；返回本页后重新检测。"
                                       TextWrapping="Wrap" />
                            <CheckBox Margin="0,12,0,0"
                                      MinHeight="40"
                                      Visibility="{Binding CanAcknowledgeIncognitoWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      IsChecked="{Binding AcknowledgedIncognitoWarning, Mode=TwoWay}"
                                      Content="我知道隐身模式当前未受保护，仍继续完成 Chrome 设置"
                                      AutomationProperties.Name="确认隐身模式未受保护" />
                            <CheckBox Margin="0,12,0,0"
                                      MinHeight="40"
                                      Visibility="{Binding IsChromeProtectionDegraded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      IsChecked="{Binding AcknowledgedChromeDegraded, Mode=TwoWay}"
                                      Content="我知道网页保护当前已降级，仍继续完成设置"
                                      AutomationProperties.Name="确认 Chrome 网页保护降级" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource WizardPanelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedOnboardingStep}" Value="4">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding OnboardingTitle}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,16"
                               Text="{Binding OnboardingBody}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="iPhone 同步清单"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,10"
                                       Text="请在手机上手工完成。收尾不会保存 Apple 凭据，也不会生成不可恢复的密码。"
                                       TextWrapping="Wrap" />
                            <CheckBox MinHeight="40" IsChecked="{Binding IPhone.HealthSleepScheduleConfigured}" Content="健康 App 的睡眠计划已设为当前台阶时间" />
                            <CheckBox MinHeight="40" IsChecked="{Binding IPhone.SleepFocusConfigured}" Content="睡眠专注已同步" />
                             <CheckBox MinHeight="40" IsChecked="{Binding IPhone.DowntimeConfigured}" Content="屏幕使用时间 → 停用时间已同步" />
                             <CheckBox MinHeight="40" IsChecked="{Binding IPhone.BlockAtDowntimeEnabled}" Content="已开启“停用期间阻止使用”" />
                            <CheckBox MinHeight="40" IsChecked="{Binding IPhone.EntertainmentCategoriesRestricted}" Content="游戏、社交、娱乐和流媒体已受限" />
                             <CheckBox MinHeight="40" IsChecked="{Binding IPhone.RequiredAppsAllowed}" Content="电话、时钟、必要联系人、验证器、交通、支付和健康工具保持允许" />
                            <CheckBox MinHeight="40" IsChecked="{Binding IPhone.SafariNotAllowlisted}" Content="Safari 没有加入始终允许" />
                            <CheckBox MinHeight="40" IsChecked="{Binding IPhone.DistinctRecoverableScreenTimePasscodeAcknowledged}" Content="屏幕使用时间密码不同于解锁码，并保留 Apple 恢复路径" />
                            <CheckBox MinHeight="40" IsChecked="{Binding IPhone.OldAlarmsChecked}" Content="已检查并关闭旧的早睡闹钟" />
                            <CheckBox MinHeight="40" IsChecked="{Binding IPhone.PhonePlacementPlanned}" Content="23:55 后手机会放到必须起身才能拿到的位置" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource WizardPanelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedOnboardingStep}" Value="5">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding OnboardingTitle}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,16"
                               Text="{Binding OnboardingBody}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource WarningCardBrush}">
                        <StackPanel>
                            <TextBlock Text="保护边界"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <CheckBox Margin="0,10,0,0"
                                      MinHeight="40"
                                      IsChecked="{Binding AcknowledgedProtectionLimit}"
                                      Content="我明白：收尾防的是临时冲动，不防管理员或主动停用；紧急入口始终可用。"
                                      AutomationProperties.Name="确认收尾的保护边界" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="服务、扩展或数据库异常会安全放行，不会断网、改电源计划或锁死账户。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    MinWidth="112"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="_上一步"
                    Command="{Binding PreviousOnboardingCommand}"
                    AutomationProperties.Name="返回上一个向导步骤"
                    TabIndex="20" />
            <TextBlock Grid.Column="1"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Text="{Binding OnboardingMissingRequirement}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       AutomationProperties.Name="当前步骤尚未完成的要求"
                       AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="2"
                    MinWidth="152"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="保存并_继续"
                    Command="{Binding NextOnboardingCommand}"
                    AutomationProperties.Name="保存当前向导步骤并继续"
                    TabIndex="21" />
        </Grid>
    </Grid>
</UserControl>
