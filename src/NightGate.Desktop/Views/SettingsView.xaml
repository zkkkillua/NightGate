<UserControl x:Class="NightGate.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NightGate.Desktop"
             xmlns:views="clr-namespace:NightGate.Desktop.Views"
             AutomationProperties.Name="收尾设置"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style TargetType="CheckBox"
               BasedOn="{StaticResource ChecklistItemStyle}" />
        <Style x:Key="CategoryPanelStyle"
               TargetType="ScrollViewer"
               BasedOn="{StaticResource PageScrollViewerStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="设置"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,14"
                       Text="按类别调整，不必重新走一遍向导。"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding SettingsCategories}"
                     SelectedItem="{Binding SelectedSettingsCategory, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     AutomationProperties.Name="设置类别"
                     TabIndex="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"
                           BasedOn="{StaticResource SettingsNavigationItemStyle}">
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="{Binding Description}"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Grid Grid.Column="2">
            <ScrollViewer>
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource CategoryPanelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSettingsCategory.Id}"
                                         Value="{x:Static local:DesktopSettingsCategory.Schedule}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="0,0,10,0">
                    <DockPanel Margin="0,0,0,14" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="作息与晋级"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="22:30 后的规则修改会安排到次日晚间生效。"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource TextButtonStyle}"
                                Content="_刷新状态"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="刷新作息与晋级状态" />
                    </DockPanel>
                    <views:ScheduleLadderView />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer>
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource CategoryPanelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSettingsCategory.Id}"
                                         Value="{x:Static local:DesktopSettingsCategory.Rules}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="程序与网站"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,14"
                               Text="管理门禁后不再允许新启动的娱乐入口。"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <Border Style="{StaticResource CardStyle}">
                        <views:RulesEditorView />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer>
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource CategoryPanelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSettingsCategory.Id}"
                                         Value="{x:Static local:DesktopSettingsCategory.Chrome}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="0,0,10,0">
                    <DockPanel Margin="0,0,0,14" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Chrome 网页保护"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="当前只支持一个已配置的 Chrome 用户资料。"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource TextButtonStyle}"
                                Content="_重新检测"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="重新检测 Chrome 网页保护" />
                    </DockPanel>
                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource InfoCardBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding ChromeProtectionText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="扩展离线或隐身模式未受保护时，网页保护会明确显示降级；最终 Windows 锁屏仍会执行。"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="收尾只读取选定娱乐网站的媒体状态，不保存页面标题、完整网址或浏览历史。"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,14,0,0"
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="{StaticResource CardBackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="授权你选择的网站"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="扩展已加载还不够：请在扩展选项中选择与“程序与网站”页面相同的网站，点击“保存并授权”，并在 Chrome 提示中允许访问。"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="打开扩展网站权限设置"
                                            Command="{Binding OpenChromeExtensionOptionsCommand}"
                                            AutomationProperties.Name="打开 Chrome 扩展网站权限设置" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="{Binding ChromeExtensionOptionsStatusText}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               AutomationProperties.Name="Chrome 扩展网站权限设置状态"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="若按钮没有打开页面：在 chrome://extensions 找到“收尾”，依次打开“详细信息”→“扩展程序选项”。"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer>
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource CategoryPanelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSettingsCategory.Id}"
                                         Value="{x:Static local:DesktopSettingsCategory.IPhone}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="iPhone 同步"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,14"
                               Text="Windows 不会替你修改 Apple 设置；晋级时再逐项确认。"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                             <TextBlock Text="iPhone 同步清单"
                                        FontSize="18"
                                        FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,10"
                                       Text="{Binding IPhoneChecklistTargetText}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel IsEnabled="{Binding CanEditIPhoneChecklist}">
                                <CheckBox MinHeight="40" IsChecked="{Binding IPhone.HealthSleepScheduleConfigured}" Content="健康 App 的睡眠计划已设为目标台阶时间" />
                                <CheckBox MinHeight="40" IsChecked="{Binding IPhone.SleepFocusConfigured}" Content="睡眠专注已同步" />
                                <CheckBox MinHeight="40" IsChecked="{Binding IPhone.DowntimeConfigured}" Content="屏幕使用时间 → 停用时间已同步" />
                                <CheckBox MinHeight="40" IsChecked="{Binding IPhone.BlockAtDowntimeEnabled}" Content="已开启“停用期间阻止使用”" />
                                <CheckBox MinHeight="40" IsChecked="{Binding IPhone.EntertainmentCategoriesRestricted}" Content="游戏、社交、娱乐和流媒体已受限" />
                                <CheckBox MinHeight="40" IsChecked="{Binding IPhone.RequiredAppsAllowed}" Content="电话、时钟、必要联系人、验证器、交通、支付和健康工具保持允许" />
                                <CheckBox MinHeight="40" IsChecked="{Binding IPhone.SafariNotAllowlisted}" Content="Safari 没有加入始终允许" />
                                <CheckBox MinHeight="40" IsChecked="{Binding IPhone.DistinctRecoverableScreenTimePasscodeAcknowledged}" Content="屏幕使用时间密码不同于解锁码，并保留 Apple 恢复路径" />
                                <CheckBox MinHeight="40" IsChecked="{Binding IPhone.OldAlarmsChecked}" Content="已检查并关闭旧的早睡闹钟" />
                                <CheckBox MinHeight="40" IsChecked="{Binding IPhone.PhonePlacementPlanned}" Content="23:55 后手机会放到必须起身才能拿到的位置" />
                                <Button Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="_确认下一台阶的手机设置"
                                        Command="{Binding ConfirmProgressionCommand}"
                                        IsEnabled="{Binding CanConfirmProgression}"
                                        AutomationProperties.Name="确认下一台阶的手机设置" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer>
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource CategoryPanelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSettingsCategory.Id}"
                                         Value="{x:Static local:DesktopSettingsCategory.Privacy}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="旧任务、历史与隐私"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,14"
                               Text="原始事件只在本机保留 90 天。"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <Border Style="{StaticResource CardStyle}"
                            Background="{StaticResource WarningCardBrush}">
                        <StackPanel>
                            <TextBlock Text="旧自动关机任务"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="每项都由你单独勾选；只停用，不删除。"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,8"
                                       Text="{Binding LegacyMigrationStatusText}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <ItemsControl ItemsSource="{Binding LegacyShutdownTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox MinHeight="40"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding TaskPath}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="停用选中的旧任务（不删除）"
                                        Command="{Binding DisableSelectedLegacyTasksCommand}"
                                        IsEnabled="{Binding CanDisableSelectedLegacyTasks}" />
                                <Button Margin="8,0,0,0"
                                        Style="{StaticResource TextButtonStyle}"
                                        Content="恢复此前停用的旧任务"
                                        Command="{Binding RestoreLegacyTasksCommand}"
                                        IsEnabled="{Binding CanRestoreLegacyTasks}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,14,0,0"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="本机历史"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="只记录时间、事件类型和网站类别；不会保存页面标题或完整浏览历史。"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="清除会删除全部本机历史，但保留今晚正在执行的状态、规则、通知防重复记录和例外机会。"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Content="清除全部本机历史…"
                                    Click="ClearHistory_Click"
                                    IsEnabled="{Binding CanClearHistory}"
                                    AutomationProperties.Name="清除全部本机历史但保留今晚状态" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
