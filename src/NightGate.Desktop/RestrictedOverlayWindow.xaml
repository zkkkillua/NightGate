<Window x:Class="NightGate.Desktop.RestrictedOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NightGate.Desktop"
        Title="收尾"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="#FF172129"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="收尾重新锁屏提示">
    <Grid Margin="42">
        <Border MaxWidth="620"
                Style="{StaticResource CardStyle}"
                Padding="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="20"
                Background="{StaticResource AppBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="该收尾了"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           AutomationProperties.Name="该收尾了" />
                <TextBlock x:Name="PhaseMessage"
                           Margin="0,12,0,0"
                           FontSize="17"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="收尾阶段说明" />
                <TextBlock x:Name="RelockCountdown"
                           Margin="0,16,0,0"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           TextAlignment="Center"
                           AutomationProperties.Name="重新锁屏倒计时"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock x:Name="ServiceDeadline"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="服务提供的例外时间" />
                <TextBlock Margin="0,10,0,0"
                           Text="{Binding Presentation.StatusText, Mode=OneWay}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="例外请求结果"
                           AutomationProperties.LiveSetting="Polite" />

                <StackPanel x:Name="ExceptionPanel" Margin="0,22,0,0">
                    <TextBlock Text="确有需要时，只使用一个入口："
                               Margin="0,0,0,8"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            MinHeight="42"
                            Margin="0,4"
                            Padding="14,8"
                            Content="_团队救场：延长当前一局"
                            Command="{Binding TeamRescueCommand}"
                            AutomationProperties.Name="团队救场，延长当前一局"
                            AutomationProperties.HelpText="每滚动一百六十八小时最多一次"
                            TabIndex="0" />
                    <TextBlock Margin="0,10,0,4"
                               Text="紧急情况 · 点击原因后立即生效"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            MinHeight="42"
                            Margin="0,4"
                            Padding="14,8"
                            Content="_健康：立即完整解锁 30 分钟"
                            Command="{Binding EmergencyHealthCommand}"
                            AutomationProperties.Name="健康紧急情况，立即完整解锁三十分钟"
                            TabIndex="1" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            MinHeight="42"
                            Margin="0,4"
                            Padding="14,8"
                            Content="_安全：立即完整解锁 30 分钟"
                            Command="{Binding EmergencySafetyCommand}"
                            AutomationProperties.Name="安全紧急情况，立即完整解锁三十分钟"
                            TabIndex="2" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            MinHeight="42"
                            Margin="0,4"
                            Padding="14,8"
                            Content="_紧急工作：立即完整解锁 30 分钟"
                            Command="{Binding EmergencyUrgentWorkCommand}"
                            AutomationProperties.Name="紧急工作，立即完整解锁三十分钟"
                            TabIndex="3" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            MinHeight="42"
                            Margin="0,4"
                            Padding="14,8"
                            Content="_娱乐再用：先冷静，再短暂使用（不可续期）"
                            Command="{Binding EntertainmentCommand}"
                            AutomationProperties.Name="娱乐再用，先冷静十分钟，再使用二十分钟，不可续期"
                            TabIndex="4" />
                </StackPanel>

                <TextBlock Margin="0,18,0,0"
                           Text="没有惩罚，也不会断网或关闭已有程序。"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="安全说明" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
