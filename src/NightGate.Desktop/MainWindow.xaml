<Window x:Class="NightGate.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NightGate.Desktop"
        xmlns:views="clr-namespace:NightGate.Desktop.Views"
        Title="收尾 NightGate"
        Icon="pack://application:,,,/Assets/NightGate.ico"
        Width="1040"
        Height="760"
        MinWidth="780"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="收尾早睡保护面板">
    <Window.Resources>
        <Style TargetType="CheckBox"
               BasedOn="{StaticResource ChecklistItemStyle}" />
    </Window.Resources>
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="收尾"
                           FontSize="30"
                           FontWeight="SemiBold"
                           AutomationProperties.Name="收尾" />
                <TextBlock Margin="0,4,0,0"
                           Text="把今晚安全地停在这里，明天继续。"
                           FontSize="15"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           AutomationProperties.Name="把今晚安全地停在这里，明天继续" />
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource StatusPillStyle}">
                <TextBlock Text="防冲动，不防蓄意拆除"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </Border>
        </DockPanel>

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="收尾功能页">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem"
                       BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="18,8" />
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem Header="今晚" AutomationProperties.Name="今晚状态">
                <ScrollViewer Margin="4,14,4,4"
                              Style="{StaticResource PageScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Presentation.PhaseText}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="当前阶段" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding Presentation.CountdownText}"
                                           FontSize="18"
                                           AutomationProperties.Name="阶段倒计时"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding Presentation.StatusText}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="当前状态"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource CardStyle}"
                                    Background="{StaticResource SuccessCardBrush}">
                                <StackPanel>
                                    <TextBlock Text="今晚规则" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="{Binding Presentation.TonightRuleText}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="今晚最后开局、锁屏、关灯与起床时间" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding Presentation.ConfigurationText}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               AutomationProperties.Name="已配置的应用和网站" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource CardStyle}"
                                    Background="{StaticResource InfoCardBrush}">
                                <StackPanel>
                                    <TextBlock Text="电脑状态（只读）" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="{Binding Presentation.SleepTimeoutText}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Windows 睡眠超时，只读" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding Presentation.ProtectionText}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               AutomationProperties.Name="保护状态" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="需要例外时" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,12"
                                           Text="入口由本机服务判断；拒绝或故障不会锁死电脑。"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="_团队救场：当前一局延长 20 分钟"
                                        Command="{Binding TeamRescueCommand}"
                                        IsEnabled="{Binding Presentation.CanRequestTeamRescue}"
                                        AutomationProperties.Name="团队救场，当前一局延长二十分钟"
                                        AutomationProperties.HelpText="每滚动一百六十八小时最多一次，只保留当前游戏和已配置语音程序"
                                        TabIndex="0" />
                                <TextBlock Margin="0,12,0,4"
                                           Text="紧急情况 · 点击原因后立即生效"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <Button Margin="0,8,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="_健康：立即完整解锁 30 分钟"
                                        Command="{Binding EmergencyHealthCommand}"
                                        IsEnabled="{Binding Presentation.CanRequestEmergency}"
                                        AutomationProperties.Name="健康紧急情况，立即完整解锁三十分钟"
                                        TabIndex="1" />
                                <Button Margin="0,8,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="_安全：立即完整解锁 30 分钟"
                                        Command="{Binding EmergencySafetyCommand}"
                                        IsEnabled="{Binding Presentation.CanRequestEmergency}"
                                        AutomationProperties.Name="安全紧急情况，立即完整解锁三十分钟"
                                        TabIndex="2" />
                                <Button Margin="0,8,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="_紧急工作：立即完整解锁 30 分钟"
                                        Command="{Binding EmergencyUrgentWorkCommand}"
                                        IsEnabled="{Binding Presentation.CanRequestEmergency}"
                                        AutomationProperties.Name="紧急工作，立即完整解锁三十分钟"
                                        TabIndex="3" />
                                <Button Margin="0,8,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="_娱乐再用：先冷静 10 分钟，再使用 20 分钟（不可续期）"
                                        Command="{Binding EntertainmentCommand}"
                                        IsEnabled="{Binding Presentation.CanRequestEntertainment}"
                                        AutomationProperties.Name="娱乐再用，先冷静十分钟，再使用二十分钟，不可续期"
                                        AutomationProperties.HelpText="娱乐窗口不可续期"
                                        TabIndex="4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding Experience.SettingsTabTitle}"
                     AutomationProperties.Name="设置与首次向导">
                <views:UserExperienceShellView Margin="4,14,4,4"
                                               DataContext="{Binding Experience}" />
            </TabItem>

            <TabItem Header="每周回顾" AutomationProperties.Name="每周回顾与简短记录">
                <ScrollViewer Margin="4,14,4,4"
                              Style="{StaticResource PageScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              DataContext="{Binding Experience}">
                    <StackPanel Margin="0,0,10,0">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="这一周" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Margin="0,10,0,0" Text="{Binding WeeklySummaryText}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0" Text="{Binding WeeklyLockText}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0" Text="{Binding WeeklyOverrideText}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="这里不显示羞辱性红叉，也不保留永久连续纪录。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,14,0,0"
                                Style="{StaticResource CardStyle}"
                                Background="{StaticResource SuccessCardBrush}">
                            <StackPanel>
                                <TextBlock Text="今晚的两项简短记录" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,8"
                                           Text="可以留空；这些记录只帮助你看趋势，不参与失败清零。"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <CheckBox MinHeight="40"
                                          IsThreeState="True"
                                          IsChecked="{Binding PhoneOutOfReach, Mode=TwoWay}"
                                          Content="睡前手机放在必须起身才能拿到的位置" />
                                <CheckBox MinHeight="40"
                                          IsThreeState="True"
                                          IsChecked="{Binding WakeWithinWindow, Mode=TwoWay}"
                                          Content="起床时间在目标前后 30 分钟内" />
                                <Button Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="_保存简短记录"
                                        Command="{Binding SaveSelfReportCommand}"
                                        AutomationProperties.Name="保存今晚的简短记录" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="4,12,4,0" LastChildFill="False">
            <TextBlock VerticalAlignment="Center"
                       Text="服务异常会安全放行；管理员始终可以停止服务或卸载。"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       AutomationProperties.Name="温和保护说明" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource TextButtonStyle}"
                    Content="_收回托盘"
                    Click="HideToTray_Click"
                    AutomationProperties.Name="收回系统托盘"
                    TabIndex="20" />
        </DockPanel>
    </Grid>
</Window>
